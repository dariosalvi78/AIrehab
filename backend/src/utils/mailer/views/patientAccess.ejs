<!DOCTYPE html>
<html>

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <%- '<style>' + include(`./index.css`) + '</style>' %>
</head>

<body>
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" class="email-wrapper">
        <tr>
            <td>&nbsp;</td>
            <td class="container">
                <div class="content">
                    <table role="presentation" border="0" cellpadding="0" cellspacing="0" class="main">
                        <tr>
                            <td class="wrapper">
                                <div class="email-logo" alt="POE assessment Logo"></div>
                                <div class="email-content">
                                    <p>
                                        You have consented to participate in the study. Save this email to have access to your personal page.<br/><br/>
                                        The link below allows you to access your personal page without needing to create an account or log in.<br/><br/>
                                        You will be able to view your POE results and change your preferences.
                                    </p>
                                    <div class="btn">
                                        <a href="<%= domain %>/patient/<%= patientID %>/profile?access=<%= accessToken %>" target="_blank">
                                            Click here to access your personal page
                                        </a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </td>
            <td>&nbsp;</td>
        </tr>
    </table>
</body>

</html>